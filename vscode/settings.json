{
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 17,
    "editor.lineHeight": 1.5,
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [
        120
    ],
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    "editor.suggestSelection": "first",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.startupEditor": "none",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "csharp.preview.improvedLaunchExperience": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.editor.enableCodeActions": true,
    "github.copilot.chat.enable": true,
    "github.copilot.chat.welcomeMessage": "default",
    "github.copilot.chat.localeOverride": "auto",
    "github.copilot.chat.followUpQuestions": "on",
    "github.copilot.chat.edits.autoApply": "always",
    "chat.editing.confirmEditRequestRemoval": false,
    "chat.editing.confirmEditRequestRetry": false,
    "chat.editing.alwaysShowToolUse": false,
    "github.copilot.advanced": {
        "authProvider": "github",
        "inlineSuggestEnable": true
    },
    "security.workspace.trust.enabled": false,
    "dotnet-test-explorer.testProjectPath": "**/*Tests.@(csproj|vbproj|fsproj)",
    "dotnet-test-explorer.autoWatch": true,
    "dotnet-test-explorer.testArguments": "/p:CollectCoverage=true",
    "dotnet-test-explorer.showCodeLens": true,
    "dotnet-test-explorer.codeLensFailed": "❌",
    "dotnet-test-explorer.codeLensPassed": "✅",
    "dotnet-test-explorer.codeLensSkipped": "⚠️",
    "window.zoomLevel": 2,
    "cline.chromeExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "roo-cline.allowedCommands": [
        "*"
    ],
    "terminal.integrated.allowWorkspaceShell": true,
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": true,
    "explorer.confirmDelete": false
}
