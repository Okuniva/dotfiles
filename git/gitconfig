[user]
	name = Okuniva
	email = okuniva@github.com

[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[branch]
	sort = -committerdate

[core]
	editor = code -w
[diff]
    renames = copies

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pager]
    diff = "diff-so-fancy | less --tabs=4 -RFX"
    show = "diff-so-fancy | less --tabs=4 -RFX"

[init]
	defaultBranch = dev

[gui]
	gcwarning = false

[pull]
  	rebase = true

[push]
	default = simple
  	followTags = true

[rebase]
	autoStash = true

[include]
	path = "~/projects/dotfiles/git/aliases.gitconfig"
	path = "~/projects/dotfiles/git/colors.gitconfig"
	path = "~/projects/dotfiles/git/conditional-includes.gitconfig"
[credential]
	helper = osxkeychain
[github]
	user = Okuniva
